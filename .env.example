# ==============================================================================
# NEXUS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Nexus is a local-first, privacy-respecting AI semantic desktop search engine.
#
# IN DESKTOP PRODUCTION:
# End users DO NOT need to configure this file manually.
# All API keys are entered directly in the application's Settings UI and are
# securely encrypted at rest in the OS Credential Manager (macOS Keychain,
# Windows Credential Manager) using AES-Fernet encryption.
#
# IN HEADLESS / DEVELOPMENT MODE:
# You may optionally supply provider credentials or host parameters below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Embeddings & Vision Captioning Provider
# ------------------------------------------------------------------------------
# Choose one of: openai, gemini, anthropic
NEXUS_DEFAULT_PROVIDER=openai

# OpenAI API Key (used for text-embedding-3-small and vision captioning)
OPENAI_API_KEY=

# Google Gemini API Key (used for text-embedding-004 and gemini-1.5-flash)
GEMINI_API_KEY=

# Anthropic API Key (used for Claude 3.5 Sonnet vision captioning)
# Note: When using Anthropic, OpenAI or Gemini key must also be provided for embeddings.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. Local Backend Service Configuration
# ------------------------------------------------------------------------------
# In desktop mode, Tauri launches the backend with port=0 (ephemeral OS-assigned port)
# to prevent port collisions. For standalone development:
NEXUS_BACKEND_HOST=127.0.0.1
NEXUS_BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 3. Storage & Metadata Paths
# ------------------------------------------------------------------------------
# By default, files are stored under ~/.nexus/ on macOS/Linux and %USERPROFILE%\.nexus\ on Windows.
# NEXUS_STORAGE_DIR=~/.nexus
# NEXUS_CHROMA_DIR=~/.nexus/chroma_data
# NEXUS_DB_PATH=~/.nexus/metadata.db
